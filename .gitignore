# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code internal worktrees
.claude/worktrees/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite databases
*.db
*.db-journal
*.sqlite
*.sqlite3

.vercel
.env*.local
video-tiendaapps/
stories/

# Manifiesto de ids de datos de prueba. Es efimero (sirve para borrarlos
# despues) y apunta a registros de la base real, asi que no va al repo.
.borradores/datos-de-prueba.json

# Pruebas a mano de los ebooks y recetarios. Gastan plata de verdad, se corren
# con `npx dotenv -e .env.local -- npx tsx probar-*.mts`, y lo que dejan —los
# PDFs, los volcados de texto y los JSON con lo generado— es para mirarlo una
# vez, no para versionarlo. Un PDF de 2 MB por corrida engorda el repo para
# siempre y no le sirve a nadie que clone.
/probar-*.mts
/dibujar-recetario.mts
/*.pdf
/ebook-generado.md
/ebook-con-continuidad.md
/ab-sin-contexto.md
/recetas-medidas.json
/recetario-*.json
/dev-tmp.log
