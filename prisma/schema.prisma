generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("BUYER")
  banned        Boolean   @default(false)
  bio           String?
  city          String?
  instagramHandle String?
  phone         String?
  notifyNewStores Boolean  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  store         Store?
  orders        Order[]
  affiliates    Affiliate[] @relation("AffiliateOwner")
  asAffiliate   Affiliate[] @relation("AffiliateUser")
  favorites     Favorite[]
  reviews       Review[]
  notifications     Notification[]
  subscription      Subscription?
  rewardCoupons     AffiliateRewardCoupon[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  auth      String
  p256dh    String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AffiliateGoal {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  targetAmount Float
  bonusRate    Float
  month        String   // "2026-05"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([storeId, month])
  @@index([storeId])
}

model Store {
  id             String   @id @default(cuid())
  slug           String   @unique
  customDomain   String?  @unique
  name           String
  description    String?
  logo           String?
  logoColor      String?
  banner         String?
  tagline        String?
  primaryColor   String   @default("#6366f1")
  secondaryColor String   @default("#f1f5f9")
  accentColor    String   @default("#f59e0b")
  fontFamily     String   @default("Inter")
  templateId     String   @default("default")
  productLayout  String   @default("grid3")
  heroStyle      String   @default("full")
  showPrices     Boolean  @default(true)
  showStock      Boolean  @default(true)
  showRatings    Boolean  @default(false)
  // Anuncio
  announcementBar      String?
  announcementBarColor String  @default("#6366f1")
  // Navbar
  navbarStyle    String   @default("solid")
  // Botones
  buttonStyle    String   @default("rounded")
  // Tarjetas
  cardRadius     String   @default("md")
  cardShadow     String   @default("sm")
  cardHover      String   @default("scale")
  // Fondo
  backgroundStyle String  @default("plain")
  // Redes sociales
  instagramUrl   String?
  facebookUrl    String?
  tiktokUrl      String?
  whatsappNumber String?
  showWhatsappButton Boolean @default(false)
  // Footer
  footerText     String?
  // Moneda y SEO
  currency       String   @default("ARS")
  seoTitle       String?
  seoDescription String?
  isActive       Boolean  @default(true)
  isPublished    Boolean  @default(false)
  affiliatesEnabled Boolean @default(false)
  commissionRate Float    @default(10)
  acceptsRewardCoupons Boolean @default(false)
  // Aceptación de términos del programa de afiliados por el titular
  tcOwnerAcceptedAt DateTime?
  tcOwnerAcceptedIp String?
  tcOwnerVersion    String?
  pageBlocks          String   @default("[]")
  navLinks            String   @default("[]")
  // Políticas legales
  policyReturns        String?
  policyShipping       String?
  policyTerms          String?
  policyReturnsActive  Boolean  @default(true)
  policyShippingActive Boolean  @default(true)
  policyTermsActive    Boolean  @default(true)
  // Footer
  footerDescription    String?
  footerShowLegal      Boolean  @default(true)
  tipoTienda          String   @default("ROPA")
  tipoTiendaConfigurado Boolean @default(false)
  tieneVentaMayorista Boolean  @default(false)
  // Config visual del nuevo editor de templates
  storeConfig     String   @default("{}")
  // MercadoPago Marketplace — credenciales del dueño de la tienda (cifradas)
  mpAccessToken   String?
  mpRefreshToken  String?
  mpSellerId      String?
  mpConnectedAt   DateTime?
  // Preview image generada al guardar el template
  previewImage         String?
  // Verificación de identidad
  isVerified           Boolean  @default(false)
  verifiedShowName     Boolean  @default(false)
  verifiedShowCity     Boolean  @default(false)
  verifiedShowPhone    Boolean  @default(false)
  verifiedShowSince    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  products            Product[]
  orders              Order[]
  affiliates          Affiliate[]
  coupons             Coupon[]
  affiliateGoals      AffiliateGoal[]
  leads               Lead[]
  publicReviews       PublicReview[]
  verificationRequest VerificationRequest?
  storeReports        StoreReport[]
}

model VerificationRequest {
  id          String    @id @default(cuid())
  storeId     String    @unique
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  dniFront    String
  dniBack     String
  selfie      String
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model Product {
  id           String   @id @default(cuid())
  name         String
  description  String?
  price        Float
  comparePrice Float?
  images       String   @default("[]")
  category     String   @default("general")
  subcategory  String?
  gender       String   @default("unisex")
  tags         String   @default("[]")
  attributes       String   @default("[]")
  reelUrls         String   @default("[]")
  precioMayorista  Float?
  cantMinMayorista Int?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  publishAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  variants       ProductVariant[]
  orderItems     OrderItem[]
  favorites      Favorite[]
  reviews        Review[]
  publicReviews  PublicReview[]

  @@index([deletedAt])
}

model ProductVariant {
  id    String  @id @default(cuid())
  name  String
  value String
  stock Int     @default(0)
  price Float?
  sku   String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
}

model Order {
  id              String   @id @default(cuid())
  status          String   @default("PENDING")
  total           Float
  subtotal        Float    @default(0)
  discountAmount  Float    @default(0)
  shippingCost    Float    @default(0)
  shippingMethod  String?
  trackingCode    String?
  notes           String?
  shippingAddress      String   @default("{}")
  lockedCommissionRate Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  items      OrderItem[]
  payment    Payment?
  shipping   Shipping?
  commission Commission?
  reviews    Review[]
  statusLogs OrderStatusLog[]
}

model OrderStatusLog {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  changedBy  String
  changedAt  DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id       String @id @default(cuid())
  quantity Int
  price    Float

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model Payment {
  id         String   @id @default(cuid())
  provider   String   @default("mercadopago")
  externalId String?  @unique
  status     String   @default("PENDING")
  amount     Float
  currency   String   @default("ARS")
  createdAt  DateTime @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipping {
  id            String   @id @default(cuid())
  provider      String
  service       String?
  trackingCode  String?
  status        String   @default("PENDING")
  estimatedDays Int?
  cost          Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Affiliate {
  id        String   @id @default(cuid())
  status    String   @default("PENDING")
  isActive  Boolean  @default(false)
  applicationMessage String?
  experience String?
  cvUrl     String?
  socialUrl String?
  requestedAt DateTime @default(now())
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  // Aceptación de términos y condiciones
  tcAcceptedAt DateTime?
  tcVersion    String?
  tcAcceptedIp String?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("AffiliateOwner", fields: [ownerId], references: [id])

  userId String
  user   User   @relation("AffiliateUser", fields: [userId], references: [id])

  orders      Order[]
  commissions Commission[]
  wallet      Wallet?
  clicks      AffiliateClick[]
  leads       Lead[]

  @@unique([storeId, userId])
}

model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  storeId     String
  ip          String?
  convertedToOrder Boolean @default(false)
  createdAt   DateTime @default(now())

  @@index([affiliateId])
  @@index([storeId])
  @@index([createdAt])
  @@index([affiliateId, ip])
}

model Commission {
  id        String   @id @default(cuid())
  amount    Float
  rate      Float
  status    String   @default("PENDING")
  paidAt    DateTime?
  createdAt DateTime @default(now())

  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])
}

model Wallet {
  id            String   @id @default(cuid())
  balance       Float    @default(0)
  totalEarned   Float    @default(0)
  totalWithdrawn Float   @default(0)
  // Datos bancarios para retiros
  cbu           String?
  alias         String?
  cuil          String?
  bankHolder    String?
  bankUpdatedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  affiliateId String    @unique
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  withdrawals WalletWithdrawal[]
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model PublicReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  reviewer  String
  createdAt DateTime @default(now())

  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, productId])
}

model Coupon {
  id             String   @id @default(cuid())
  code           String
  discountType   String   @default("percentage")
  discountValue  Float
  minOrderAmount Float    @default(0)
  maxUses        Int?
  usedCount      Int      @default(0)
  expiresAt      DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  orders Order[]

  @@unique([storeId, code])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WalletWithdrawal {
  id        String   @id @default(cuid())
  amount    Float
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  location  String?
  text      String
  rating    Int      @default(5)
  photoUrl  String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// CUPONES DE PREMIO
// level:  SILVER | GOLD | DIAMOND
// type:   STORE | SUBSCRIPTION
// status: AVAILABLE | USED | EXPIRED
model AffiliateRewardCoupon {
  id            String   @id @default(cuid())
  code          String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // STORE | SUBSCRIPTION
  level         String   // SILVER | GOLD | DIAMOND
  plan          String   // MONTHLY | ANNUAL
  discountValue Float
  earnedMonth   String   // "2026-04"
  status        String   @default("AVAILABLE") // AVAILABLE | USED | EXPIRED
  usedAt        DateTime?
  usedOrderId   String?
  usedStoreName String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
}

// AUDIT DE CUENTAS ELIMINADAS — resguardo legal/fiscal
// Se crea al eliminar una cuenta desde el panel admin.
// Preserva aceptaciones de T&C y resumen de suscripción para disputas legales y AFIP.
model DeletedAccountAudit {
  id               String   @id @default(cuid())
  deletedAt        DateTime @default(now())
  deletedByAdminId String
  originalUserId   String
  originalEmail    String?  // guardado antes de anonimizar
  originalName     String?  // guardado antes de anonimizar
  accountType      String   // OWNER | SELLER | BUYER
  accountCreatedAt DateTime

  // Aceptación de T&C del programa de afiliados
  tcAffiliateAcceptedAt DateTime?
  tcAffiliateVersion    String?
  tcAffiliateAcceptedIp String?

  // Aceptación de T&C del programa de dueños de tienda
  tcOwnerAcceptedAt DateTime?
  tcOwnerVersion    String?
  tcOwnerAcceptedIp String?

  // Resumen de suscripción (para registro fiscal)
  subscriptionRole      String?
  subscriptionPlan      String?
  subscriptionStatus    String?
  subscriptionCreatedAt DateTime?
}

// LOG DE ACCIONES ADMIN — auditoría de seguridad interna
// Se registra cada acción relevante que un admin realiza desde el panel.
model AdminActionLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  adminId    String
  adminEmail String
  action     String   // BAN | UNBAN | DELETE | CHANGE_STATUS | CHANGE_TIER | CHANGE_PLAN | TOGGLE_STORE
  targetId   String   // userId o storeId afectado
  targetType String   // USER | STORE | SUBSCRIPTION
  details    String   // JSON con datos adicionales del cambio
  ip         String?
}

// SUSCRIPCIONES
// status: TRIAL | ACTIVE | GRACE | EXPIRED | CANCELLED
// plan:   MONTHLY | ANNUAL
// role:   AFFILIATE | OWNER
model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              String   // AFFILIATE | OWNER
  tier              String   @default("BASIC") // BASIC | PREMIUM (solo para OWNER)
  plan              String   // MONTHLY | ANNUAL
  status            String   @default("TRIAL") // TRIAL | ACTIVE | GRACE | EXPIRED | CANCELLED
  trialEndsAt       DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  gracePeriodEndsAt DateTime?
  cancelAtPeriodEnd Boolean  @default(false)
  mpPaymentId       String?
  mpPreapprovalId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Consultas/leads para tiendas de tipo inquiry (VEHICULOS, INMOBILIARIA, etc.)
// Se crea cuando un cliente hace click en "Consultar por WhatsApp" desde un link de afiliado
model Lead {
  id              String    @id @default(cuid())
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  affiliateId     String?
  affiliate       Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  productId       String?
  productName     String
  productPrice    Float
  customerName    String?
  customerPhone   String?
  customerMessage String?
  // PENDING = consultó / CONFIRMED = venta confirmada / REJECTED = no concretó
  status          String    @default("PENDING")
  commissionAmount Float?
  commissionRate  Float?
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([storeId, createdAt(sort: Desc)])
  @@index([affiliateId])
}

model StoreReport {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reporterEmail String?
  reason       String
  description  String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
  @@index([status, createdAt(sort: Desc)])
}
