generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String    @unique
  emailVerified          DateTime?
  image                  String?
  bannerImage            String?
  password               String?
  role                   String    @default("BUYER")
  banned                 Boolean   @default(false)
  bio                    String?
  city                   String?
  instagramHandle        String?
  phone                  String?
  notifyNewStores        Boolean   @default(false)
  preferredPlacaTemplate String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  // Aceptación de Términos y Condiciones generales al registrarse (cualquier rol)
  termsAcceptedAt        DateTime?
  termsVersion           String?
  termsAcceptedIp        String?
  // Última versión de los términos por la que se le mandó el aviso por email.
  // Separada de termsVersion (que es lo que ACEPTÓ) para no volver a escribirle
  // a quien ya fue avisado pero todavía no entró a aceptar.
  termsNotifiedVersion   String?
  // Datos bancarios para retiros de comisiones (únicos por persona, aplican a todas sus afiliaciones)
  affiliateCbu           String?
  affiliateAlias         String?
  affiliateCuil          String?
  affiliateBankHolder    String?
  affiliateBankUpdatedAt DateTime?
  // OTP para verificación de identidad antes de acceder/modificar datos bancarios
  otpCode                String?
  otpExpiresAt           DateTime?
  otpPurpose             String?
  otpAttempts            Int       @default(0) // intentos fallidos; se resetea al verificar o al generar nuevo código

  accounts           Account[]
  sessions           Session[]
  store              Store?
  orders             Order[]
  affiliates         Affiliate[]             @relation("AffiliateOwner")
  asAffiliate        Affiliate[]             @relation("AffiliateUser")
  favorites          Favorite[]
  reviews            Review[]
  notifications      Notification[]
  subscription       Subscription?
  rewardCoupons      AffiliateRewardCoupon[]
  pushSubscriptions  PushSubscription[]
  storeSubscriptions StoreSubscription[]
  storeFollows       StoreFollow[]
  donations          Donation[]
  asistenteMensajes  AsistenteMensaje[]
  /// Cuántas generaciones de IA le quedan, por concepto. Ver `CupoIA`.
  cuposIA            CupoIA[]
  /// Los ebooks que la IA le está escribiendo o le escribió. Ver `EbookIA`.
  ebooksIA           EbookIA[]
}

// Historial de chat con Sasha (asistente IA del dashboard). Se guarda en la base
// para que sea el mismo en cualquier dispositivo, y se filtra por `day` (zona Argentina)
// para mantener el reseteo diario que ya tenía la versión basada en localStorage.
//
// Acá viven DOS cosas distintas y por eso está `esAviso`:
//
//   - La charla del día. Se borra sola: si hoy es 30, lo de ayer no se muestra.
//   - Los avisos que manda Sasha sola cada mañana. Ésos NO pueden desaparecer al
//     cambiar el día — si te escribe el martes y entrás el jueves, tiene que estar
//     ahí. Se muestran mientras estén sin leer (de cualquier día) y además todo el
//     día en que llegaron, aunque ya los hayas leído: si sólo se mostraran los sin
//     leer, leerlo de un vistazo y recargar la página lo hacía desaparecer.
//
// Mezclarlos en la misma tabla es a propósito: en la pantalla son la misma
// conversación, y separarlos en dos modelos obligaría a ordenarlos a mano cada vez.
model AsistenteMensaje {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  day       String // YYYY-MM-DD en zona Argentina
  /// true = lo mandó Sasha sola, no es respuesta a nada. Sobrevive al cambio de día.
  esAviso   Boolean   @default(false)
  /// Qué clase de aviso es ("stock-agotado", "ventas-bajando"). Evita repetirlo
  /// todos los días: si el stock sigue bajo el martes, ya lo dijo el lunes.
  clave     String?
  /// null = sin leer. Es lo que cuenta el globito.
  leidoAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, day])
  // Para el contador: los sin leer de un usuario, sin escanear todo el historial.
  @@index([userId, esAviso, leidoAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  auth      String
  p256dh    String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AffiliateGoal {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  targetAmount Float
  bonusRate    Float
  month        String // "2026-05"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([storeId, month])
  @@index([storeId])
}

model Store {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  customDomain          String?   @unique
  name                  String
  description           String?
  logo                  String?
  logoColor             String?
  banner                String?
  tagline               String?
  primaryColor          String    @default("#6366f1")
  secondaryColor        String    @default("#f1f5f9")
  accentColor           String    @default("#f59e0b")
  fontFamily            String    @default("Inter")
  templateId            String    @default("default")
  productLayout         String    @default("grid3")
  heroStyle             String    @default("full")
  showPrices            Boolean   @default(true)
  showStock             Boolean   @default(true)
  showRatings           Boolean   @default(false)
  // Anuncio
  announcementBar       String?
  announcementBarColor  String    @default("#6366f1")
  // Navbar
  navbarStyle           String    @default("solid")
  // Botones
  buttonStyle           String    @default("rounded")
  // Tarjetas
  cardRadius            String    @default("md")
  cardShadow            String    @default("sm")
  cardHover             String    @default("scale")
  // Fondo
  backgroundStyle       String    @default("plain")
  // Redes sociales
  instagramUrl          String?
  facebookUrl           String?
  tiktokUrl             String?
  whatsappNumber        String?
  showWhatsappButton    Boolean   @default(false)
  // Footer
  footerText            String?
  currency              String    @default("ARS")
  // OJO: estas dos NO son el SEO de la tienda. Están huérfanas.
  //
  // El SEO de la portada vive en `storeConfig.seo` (JSON): lo escribe el editor
  // —Configuración → "🔍 SEO / Google"— y lo lee `generateMetadata` en
  // `app/tienda/[slug]/page.tsx`. Ése es el camino que funciona.
  //
  // Estas columnas no las edita ninguna pantalla y no las lee ninguna página. El
  // PUT de `/api/configuracion` las guarda, pero sus dos únicos llamadores hacen
  // un GET antes y reenvían todo tal cual, así que se reescribe el null que ya
  // tenían. Quedan por si algún día se migra el SEO del JSON a columnas de
  // verdad; hasta entonces, no buscar acá.
  //
  // El SEO por PRODUCTO es otra cosa y sí funciona: `Product.seoTitle`.
  seoTitle              String?
  seoDescription        String?
  isActive              Boolean   @default(true)
  isPublished           Boolean   @default(false)
  // Cierre voluntario de la dueña, o automático por falta de pago. Campo propio
  // y NO `isActive` a propósito: ese ya significa "bajada por denuncia" y
  // "cuenta eliminada", y una tienda cerrada por su dueña no puede mostrarle al
  // visitante el mismo mensaje que una bajada por moderación. La cuenta sigue
  // activa: entra al panel, ve el estado y la reactiva cuando quiere.
  closedAt              DateTime?
  affiliatesEnabled     Boolean   @default(false)
  commissionRate        Float     @default(10)
  acceptsRewardCoupons  Boolean   @default(false)
  // Aceptación de términos del programa de afiliados por el titular
  tcOwnerAcceptedAt     DateTime?
  tcOwnerAcceptedIp     String?
  tcOwnerVersion        String?
  pageBlocks            String    @default("[]")
  navLinks              String    @default("[]")
  // Políticas legales
  policyReturns         String?
  policyShipping        String?
  policyTerms           String?
  // La de privacidad es la cuarta y llegó última, pero no es opcional en la
  // práctica: /terminos §5 bis y /privacidad §4 de la plataforma le dicen al
  // dueño que "sos el único responsable de informarlo en tu política de
  // privacidad". Sin este campo le exigíamos por escrito un documento que el
  // panel no le daba forma de escribir.
  policyPrivacy         String?
  policyReturnsActive   Boolean   @default(true)
  policyShippingActive  Boolean   @default(true)
  policyTermsActive     Boolean   @default(true)
  policyPrivacyActive   Boolean   @default(true)
  // Cuándo se tocó por última vez cualquiera de las cuatro. Se muestra al pie
  // de la página legal pública: ante un reclamo, importa poder decir qué decía
  // la política y desde cuándo.
  policiesUpdatedAt     DateTime?
  // Footer
  footerDescription     String?
  footerShowLegal       Boolean   @default(true)
  tipoTienda            String    @default("ROPA")
  tipoTiendaConfigurado Boolean   @default(false)
  tieneVentaMayorista   Boolean   @default(false)
  // Config visual del nuevo editor de templates
  storeConfig           String    @default("{}")
  // ── Configuración de una cuenta de Productos Digitales ──────────────────────
  //
  // Van como columnas y no adentro de `storeConfig` porque `storeConfig` es la
  // config VISUAL del editor de templates: se reescribe entero cada vez que se
  // guarda un diseño, y estos cuatro campos no tienen nada que ver con el
  // diseño. Un guardado de template se los llevaría puestos.
  //
  // Los cuatro son opcionales: una cuenta que recién entra no tiene ninguno, y
  // la pantalla tiene que poder dibujarse igual.

  // El nombre que ve el comprador durante el pago y en la página de descarga.
  // Separado de `name` a propósito: el de la marca puede ser largo o gracioso, y
  // el que aparece en el resumen de la tarjeta conviene que sea reconocible. Si
  // está vacío se usa `name`.
  checkoutName          String?
  // A dónde escribe quien compró y no recibió el archivo. Va en el mail de
  // entrega, así que es la única forma que tiene esa persona de reclamar.
  supportEmail          String?
  // Un mail a quien vende por cada venta cobrada (Configuración → Avisos).
  // Apagado de fábrica: el push y la campanita ya avisan; el mail es para quien
  // quiere el comprobante en la casilla.
  avisoMailVentas       Boolean   @default(false)
  // ── El contexto de la IA ────────────────────────────────────────────────────
  // El NICHO de la cuenta: lo que la IA usa como referencia para todo lo que
  // genera (el ebook, los bonos, los upsells y los textos de venta). Sin esto,
  // cada generación arranca de cero y sale de otro tema.
  iaProducto            String?
  iaDescripcion         String?
  // MercadoPago Marketplace — credenciales del dueño de la tienda (cifradas)
  mpAccessToken         String?
  mpRefreshToken        String?
  mpSellerId            String?
  mpConnectedAt         DateTime?
  // Facebook/Meta — catálogo de productos vía Business Manager (token cifrado)
  fbAccessToken         String?
  fbUserId              String?
  fbBusinessId          String?
  fbCatalogId           String?
  fbFeedId              String?
  fbWabaId              String?
  fbConnectedAt         DateTime?
  // Cuándo vence `fbAccessToken`. Los de larga duración de Meta duran ~60 días y
  // no se renuevan solos: sin esta fecha no había forma de saber que una conexión
  // estaba muerta, y la pantalla seguía diciendo "Instalada" en verde.
  fbTokenExpiresAt      DateTime?
  // Google Analytics — vía OAuth (Google Analytics Admin API, refresh token cifrado)
  gaRefreshToken        String?
  gaAccountId           String?
  gaPropertyId          String?
  gaConnectedAt         DateTime?
  // Google Shopping — opt-in del dueño para que sus productos entren al feed
  // central de Merchant Center de la plataforma. No hay OAuth: es solo el
  // permiso explícito de la tienda para publicarse en Google.
  gsEnabledAt           DateTime?
  // Última vez que el dueño abrió Carritos abandonados. El puntito del sidebar
  // cuenta los carritos con actividad posterior a esta fecha, no los pendientes:
  // un carrito abandonado casi nunca se "resuelve" (recoveredAt se llena solo si
  // la persona vuelve y compra), así que un contador de pendientes quedaría
  // prendido para siempre y se volvería ruido. NULL = nunca la abrió, todos nuevos.
  abandonedCartsSeenAt  DateTime?
  // Preview image generada al guardar el template
  previewImage          String?
  // Dirección de origen para cotizar envío en vivo (Envíopack). Opcional:
  // sin esto, la tienda solo puede usar métodos fijos/"a coordinar".
  originStreet          String?
  originCity            String?
  originProvince        String? // código de provincia (ej: "B", "X", "C")
  originPostalCode      String?
  // Cuándo terminó de configurarse la tienda por primera vez. Se marca sola y no
  // se borra nunca: distingue "nunca lo configuró" de "lo tenía y se le rompió".
  // Ver lib/avisos-tienda.
  onboardingCompletedAt DateTime?
  // Verificación de identidad
  isVerified            Boolean   @default(false)
  verificationBanned    Boolean   @default(false)
  verifiedShowName      Boolean   @default(false)
  verifiedShowCity      Boolean   @default(false)
  verifiedShowPhone     Boolean   @default(false)
  verifiedShowSince     Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  products            Product[]
  orders              Order[]
  affiliates          Affiliate[]
  coupons             Coupon[]
  cuponesDigital      CuponDigital[]
  correosDigital      CorreoDigital[]
  bajasDeCorreo       BajaCorreoDigital[]
  affiliateGoals      AffiliateGoal[]
  leads               Lead[]
  publicReviews       PublicReview[]
  verificationRequest VerificationRequest?
  storeReports        StoreReport[]
  closures            StoreClosure[]
  storeSubscriptions  StoreSubscription[]
  pushCampaigns       PushCampaign[]
  storeViews          StoreView[]
  storeViewSources    StoreViewSource[]
  storeFunnelSteps    StoreFunnelStep[]
  storeFollows        StoreFollow[]
  abandonedCarts      AbandonedCart[]
  gamificationWidget  GamificationWidget?
  activityEvents      StoreActivityEvent[]
  milestones          StoreMilestone[]
  archives            StoreArchive[]
  promotions          StorePromotion[]
  newsletter          NewsletterSubscriber[]
  arrepentimientos    Arrepentimiento[]
}

// Suscripciones push a tiendas. userId es null para suscriptores anónimos legacy;
// los nuevos seguidores autenticados tienen userId seteado.
model StoreSubscription {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  endpoint  String   @unique
  auth      String
  p256dh    String
  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([userId])
}

// Seguidores autenticados de una tienda.
// Creado cuando un usuario logueado toca "Seguir tienda" en el storefront
// (no está restringido por rol: dueños y afiliados también pueden seguir tiendas).
model StoreFollow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
}

// Historial de notificaciones push enviadas por una tienda.
// Usado también para rate limiting (max 2 por semana).
//
// Desde el newsletter una campaña sale por DOS canales: push a los seguidores
// registrados y mail a los suscriptores confirmados. El registro es uno solo
// —un mensaje es un mensaje, y el límite semanal cuenta campañas, no envíos—
// pero los conteos van separados porque los públicos no se superponen.
model PushCampaign {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title     String
  body      String
  url       String?
  sentCount Int       @default(0)
  createdAt DateTime  @default(now())
  // Null = nunca expira. Si tiene fecha, deja de mostrarse en la tienda
  // pública al pasar esa fecha, pero el registro se conserva para el
  // historial del dueño hasta que él lo borre.
  expiresAt DateTime?

  // ── Envío por mail ────────────────────────────────────────────────────────
  // PENDIENTE → todavía no salió ningún mail
  // ENVIANDO  → quedó a mitad de camino (se cortó la función, o falta una tanda)
  // LISTO     → se recorrió toda la lista
  // SIN_MAIL  → esta tienda no tiene suscriptores por mail; nunca hubo nada que hacer
  /// Borrado blando: el dueño la sacó de su historial.
  ///
  /// No se borra la fila porque el límite de 3 por semana se cuenta sobre estas
  /// filas. Con un DELETE de verdad, mandar tres y borrarlas devolvía el cupo —
  /// se podían mandar nueve mensajes en una semana y el panel seguía diciendo
  /// "te quedan 3". Y el tope existe justamente para no quemar la reputación
  /// del dominio de envío, que comparten todas las tiendas.
  ///
  /// Lo que se deshace es el registro, no el envío: un push entregado no vuelve
  /// del celular y un mail mandado no se recupera. Por eso el contador tiene que
  /// seguir contándolo.
  deletedAt DateTime?

  emailStatus String @default("SIN_MAIL")
  sentEmail   Int    @default(0)

  /// Hasta dónde llegó el envío por mail, recorriendo los suscriptores por
  /// (createdAt, id) ascendente. Guarda el id del ÚLTIMO al que se le mandó.
  ///
  /// Es lo que hace que reintentar no duplique: sin cursor, un envío que se
  /// corta en el 300 y se reintenta le manda de nuevo a esos 300. Va desde el
  /// día uno aunque las listas sean chicas, porque el reintento es justamente
  /// lo primero que hace el dueño cuando ve un error.
  emailCursor String?

  @@index([storeId, createdAt(sort: Desc)])
  // Para que el drenado (hoy manual, mañana por cron) encuentre lo que quedó
  // a medias sin recorrer todo el historial.
  @@index([emailStatus])
  // El historial del panel y el banner de la tienda filtran por (tienda, no
  // borrada). El índice existía en la base desde la migración del borrado
  // blando, pero nunca se declaró acá: `prisma migrate diff` lo veía de más y
  // proponía borrarlo, que era exactamente lo contrario de lo que hay que hacer.
  @@index([storeId, deletedAt])
}

/// Suscriptor del newsletter de una tienda: alguien que dejó su mail en el
/// bloque de suscripción del storefront.
///
/// No es lo mismo que un StoreFollow. El seguidor está registrado en la
/// plataforma y recibe PUSH en su dispositivo; el suscriptor es una dirección
/// de mail suelta, sin cuenta, y recibe MAIL. A un mail no se le puede mandar un
/// push, así que son dos listas distintas que se muestran juntas.
model NewsletterSubscriber {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Siempre en minúsculas y sin espacios: se normaliza al darlo de alta, para
  /// que el @@unique de abajo no deje entrar "Ana@X.com" y "ana@x.com" como dos.
  email String

  /// Doble opt-in. Mientras esté en false NO recibe nada.
  ///
  /// Cualquiera puede escribir el mail de otro en el formulario. Si contáramos
  /// ese alta como buena, a esa persona le llegaría publicidad de una tienda que
  /// no conoce, y su único botón a mano es "spam" — que en este proyecto lo
  /// pagan TODAS las tiendas, porque comparten el dominio de envío.
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?

  /// Sirve para confirmar y para darse de baja. Es el mismo a propósito: son dos
  /// links dentro de mails que ya van dirigidos a esta persona, y una segunda
  /// columna no agregaría seguridad real, sólo otra cosa que puede desincronizar.
  token String @unique

  /// Apagado por rebote duro o por denuncia de spam (webhook de Resend), o
  /// porque el dueño lo borró de la lista. Se apaga en vez de borrarse: si se
  /// borrara, el mismo mail podría volver a entrar por el formulario y
  /// seguiríamos escribiéndole a una casilla que ya nos denunció.
  bajaEn     DateTime?
  bajaMotivo String?

  /// Para el rate limit y para rastrear un alta masiva si alguna vez pasa.
  ip String?

  createdAt DateTime @default(now())

  @@unique([storeId, email])
  // El envío recorre (confirmado, sin baja) ordenado por createdAt/id — el
  // mismo orden que asume el cursor de la campaña.
  @@index([storeId, confirmed, createdAt])
}

model VerificationRequest {
  id         String    @id @default(cuid())
  storeId    String    @unique
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  dniFront   String
  dniBack    String
  selfie     String
  cuit       String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

model Product {
  id                 String    @id @default(cuid())
  name               String
  description        String?
  price              Float
  comparePrice       Float?
  // Costo interno del producto (nunca se muestra en la tienda). Se usa para
  // calcular el margen de ganancia. null = sin dato cargado (no asumir 0).
  costPrice          Float?
  featured           Boolean   @default(false)
  viewCount          Int       @default(0)
  images             String    @default("[]")
  category           String    @default("general")
  subcategory        String?
  gender             String    @default("unisex")
  tags               String    @default("[]")
  attributes         String    @default("[]")
  reelUrls           String    @default("[]")
  precioMayorista    Float?
  cantMinMayorista   Int?
  // Escalones de precio mayorista: JSON array [{desde:Int, precio:Float}] en orden ascendente por "desde".
  // Cada banda aplica a partir de "desde" unidades; precio debe ser < precioMayorista.
  preciosEscalonados String    @default("[]")
  // Producto exclusivo de catálogo mayorista: solo aparece en tiendas con tieneVentaMayorista=true.
  soloMayorista      Boolean   @default(false)
  // Descuento por cantidad (retail): aplica cuando el cliente suma promoQtyMin o más unidades del mismo producto.
  // promoType: "PERCENT" = porcentaje de descuento | "N_PAY_M" = llevá N pagá M
  promoQtyMin        Int?
  promoQtyDiscount   Float?
  promoType          String    @default("PERCENT")
  promoPayQty        Int?
  offerBadge         String?
  offerNote          String?
  offerEndsAt        DateTime?
  // Cuotas sin interés informativas (no conectado a ninguna API bancaria ni
  // de Mercado Pago): 0 = no mostrar, o 3/6/12. Solo se muestra en la tienda
  // si además la tienda tiene Mercado Pago conectado.
  cuotas             Int       @default(0)
  // Título y descripción propios para los resultados de Google. null = armarlos
  // solos a partir del nombre y la descripción (ver `generateMetadata` en la
  // ficha de producto). Sin límite de largo en la base a propósito: los 60/160
  // de Google son cuánto MUESTRA, no un máximo válido — el aviso va en el
  // formulario, que es donde se puede explicar.
  seoTitle           String?
  seoDescription     String?
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  publishAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vehicleStatus  String?
  soldAt         DateTime?
  soldPrice      Float?
  soldBuyerName  String?
  soldBuyerPhone String?
  soldNotes      String?

  // Peso y dimensiones del paquete, usados para cotizar envío real (Envíopack)
  weightKg Float?
  widthCm  Float?
  heightCm Float?
  depthCm  Float?

  // ── SIN USO HOY. Ver la nota de `DigitalDownload`, más abajo ──────────────
  // Estas tres columnas EXISTEN EN LA BASE de producción: la migración
  // 20260828120000_add_producto_digital se aplicó. Ningún código las lee ni las
  // escribe desde que los productos digitales dejaron de ser un rubro de tienda
  // y pasaron a ser un producto aparte.
  //
  // Se dejan declaradas a propósito. Sacarlas de acá no las saca de la base: lo
  // único que lograría es que Prisma vea una base con columnas que su esquema no
  // menciona, y la próxima migración de CUALQUIER otra cosa pida un reset — en
  // la base de producción. Son nullable y no molestan a nadie.
  //
  // Cuando se arme el ecosistema propio, el diseño de abajo sigue valiendo:
  // `archivoPath` guarda la RUTA en el bucket PRIVADO con el formato
  // `supabase://<bucket>/<path>`, nunca una URL pública — si acá hubiera una url
  // servible, el archivo pago se bajaría sin comprarlo con solo tenerla. Quien
  // corresponde pide un link firmado y de vida corta. Mismo criterio que los
  // documentos de afiliados; ver /api/vendedoras/cv/[id].
  // Los tres son nullable: un producto físico no tiene ninguno.
  archivoPath   String?
  archivoNombre String?
  archivoPeso   Int?

  /// ── El embudo de Productos Digitales ──────────────────────────────────────
  ///
  /// Un producto digital, un bono y un upsell son LA MISMA COSA: un archivo con
  /// título, descripción, precio e imagen. Lo único que los separa es el papel
  /// que juegan y de quién cuelgan.
  ///
  ///   PRINCIPAL → es lo que se compra. Tiene su propia página de venta.
  ///   BONO      → va de regalo con la compra. Precio 0, y `comparePrice`
  ///               guarda el valor que se muestra tachado.
  ///   UPSELL    → se ofrece aparte durante el checkout, con su propio precio.
  ///
  /// Por eso NO hay tablas nuevas. Dos tablas más —una de bonos y otra de
  /// upsells— serían dos copias del mismo formulario, de la misma subida de
  /// archivo y de la misma entrega, que después se desincronizan de a una.
  ///
  /// `null` en un producto de tienda, que es lo que son todos hoy.
  rolDigital  String?
  /// El contenido de su página de venta: un JSON con las secciones, su orden,
  /// cuáles están encendidas y los textos de cada una.
  ///
  /// La FORMA la declara `lib/pagina-venta`, no la base. Lo que entra pasa antes
  /// por `normalizarContenido`, que descarta lo que no está en el catálogo y
  /// recorta cada campo a su tope; acá se guarda el resultado.
  ///
  /// `null` = todavía no la tocaron, y se dibuja con los textos de fábrica. Sólo
  /// tiene sentido en un PRINCIPAL: los bonos y los upsells viajan adentro de la
  /// página de él, no tienen una propia.
  paginaVenta String?
  /// El ebook que le está escribiendo la IA, si pidió uno. Ver `EbookIA`.
  ebookIA     EbookIA?
  /// ⚠️ LA DIRECCIÓN DEL PRODUCTO: `mecanica.tiendaapps.com`.
  ///
  /// Cada producto digital principal es **su propio sitio**. La cuenta no la ve
  /// nunca nadie: quien llega desde un anuncio de tortas ve tortas y nada más.
  /// Por eso la dirección cuelga del producto y no de la cuenta.
  ///
  /// Va en LOS TRES PLANES y existe desde que el producto se crea. Si apareciera
  /// recién al mejorar de plan, la dirección CAMBIARÍA — y cambiarle la URL a
  /// algo que ya se está publicitando se lleva puestos los anuncios corriendo,
  /// el historial del píxel y todos los links compartidos.
  ///
  /// ⚠️ Comparte el espacio de nombres con `Store.slug`: los dos se traducen
  /// desde el mismo subdominio. Que sean únicos entre las dos tablas no lo puede
  /// garantizar un índice —vive en tablas distintas— así que lo garantiza un
  /// candado al reservarlo. Ver `lib/direccion-digital`.
  ///
  /// `null` en un producto de tienda, en un bono y en un upsell: un bono no es
  /// una página que alguien visite, se entrega con la compra.
  slugDigital String? @unique
  /// El dominio propio del comerciante: `mecanicafacil.com`. Sólo Pro.
  ///
  /// Existe acá y no en `Store` —donde ya está `customDomain`— porque aquél es
  /// @unique por cuenta, o sea UNO. Pro tiene cinco productos y cada uno lleva
  /// el suyo, así que el dominio tiene que colgar del producto.
  dominioPropio String? @unique
  /// La medición de ESTA página (píxel de Meta, GA, Clarity), como JSON. Vacío
  /// o sin una clave = usa el de la cuenta (`Store.storeConfig.analytics`).
  /// Una cuenta Pro tiene hasta 5 páginas con dominio propio: pueden ser cinco
  /// negocios con cinco cuentas de anuncios. La forma la declara
  /// `lib/medicion-digital`.
  medicion      String?
  /// La oferta de salida (el "downsell"): qué se le ofrece a quien se va del
  /// checkout sin pagar, como JSON. Null = apagada. La forma la declara
  /// `lib/oferta-salida`; el cupón que crea vive en `CuponDigital`.
  ofertaSalida  String?
  /// El precio de bienvenida: un descuento que vale un rato desde que cada
  /// visitante ENTRA a la página (el "reservado por 15:00", pero de verdad:
  /// el plazo lo firma el servidor y lo hace cumplir al cobrar). JSON; la
  /// forma la declara `lib/bienvenida`; el cupón que crea vive en `CuponDigital`.
  bienvenida    String?
  /// Estaba publicado cuando la dueña cerró su cuenta digital (`Store.closedAt`):
  /// al reabrir, éstos y sólo éstos vuelven a publicarse. Mismo molde que
  /// `Affiliate.pausedByClosure`. Ver `lib/cierre-digital`.
  pausadoPorCierre Boolean @default(false)
  /// La landing propia (el HTML que diseñó con Claude): si está prendida,
  /// qué versión se muestra, las fotos por nombre de hueco y los links del
  /// pie. JSON; la forma la declara `lib/landing-estado`. Las versiones del
  /// HTML viven en `LandingDigital`.
  landingPropia String?
  /// De qué PRINCIPAL cuelga. Null en el principal y en todo producto físico.
  /// Con `Cascade`: borrar el principal se lleva sus bonos y sus upsells, que no
  /// tienen dónde vivir sin él.
  padreId     String?
  padre       Product?  @relation("EmbudoDigital", fields: [padreId], references: [id], onDelete: Cascade)
  hijos       Product[] @relation("EmbudoDigital")

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  variants        ProductVariant[]
  orderItems      OrderItem[]
  favorites       Favorite[]
  reviews         Review[]
  publicReviews   PublicReview[]
  stockMovements  StockMovement[]
  affiliateClicks AffiliateClick[]
  expenses        VehicleExpense[]
  visitasDigital  DigitalVisita[]
  origenesDigital DigitalVisitaOrigen[]
  campaniasDigital DigitalVisitaCampania[]
  cuponesDigital  CuponDigital[]
  correosDigital  CorreoDigital[]
  landingsDigital LandingDigital[]

  @@index([deletedAt])
  // Todo lo que se le pide a esta tabla arranca por la tienda: el catálogo que
  // sirve `/api/public/[slug]`, los géneros que decide el menú, el panel, las
  // métricas. Sin este índice cada una de esas consultas lee la tabla ENTERA.
  // Hoy no se nota —116 filas, y con tan pocas Postgres elige el escaneo igual
  // porque sale más barato que ir al índice y volver— pero el que crece es
  // justamente el número de productos de todas las tiendas juntas, y el día que
  // se note ya va a estar doliendo en cada visita.
  @@index([storeId])
  // La ficha de un producto digital pide sus bonos y sus upsells de una:
  // `where: { padreId }`. Sin esto es un escaneo de la tabla entera —la de TODAS
  // las tiendas— cada vez que alguien abre un producto o su página de venta.
  @@index([padreId])
}

// Gastos asociados a un vehículo (Autos/Motos): compra, lavado, service,
// cubiertas, etc. Reemplaza el campo único "costo" para este rubro porque un
// vehículo suele acumular varios gastos a lo largo del tiempo, no uno solo.
model VehicleExpense {
  id        String    @id @default(cuid())
  concepto  String
  monto     Float
  fecha     DateTime?
  createdAt DateTime  @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id                  String    @id @default(cuid())
  name                String
  value               String
  stock               Int       @default(0)
  price               Float?
  sku                 String?
  lowStockThreshold   Int?
  lowStockAlertSentAt DateTime?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems     OrderItem[]
  stockMovements StockMovement[]
}

model StockMovement {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String // MANUAL | SALE | CANCELLATION | BULK_ADJUST | PRODUCT_EDIT
  delta       Int
  stockBefore Int
  stockAfter  Int
  reason      String?
  changedBy   String
  createdAt   DateTime       @default(now())

  @@index([variantId])
  @@index([productId])
  @@index([createdAt])
}

model Order {
  id                   String  @id @default(cuid())
  status               String  @default("PENDING")
  total                Float
  subtotal             Float   @default(0)
  discountAmount       Float   @default(0)
  shippingCost         Float   @default(0)
  // Lo que el envío HABRÍA costado cuando una promo lo bonificó. `shippingCost`
  // guarda lo que pagó el comprador (0 con envío gratis), así que sin esta columna
  // el costo del envío regalado desaparecía del sistema y Métricas contaba esa
  // plata como ganancia. 0 = no se bonificó nada (#7c).
  shippingWaived       Float   @default(0)
  shippingMethod       String?
  // Promociones aplicadas, "congeladas" al momento de la venta: después la promo
  // puede cambiar, pausarse o archivarse, y el comprobante tiene que seguir diciendo
  // la verdad de lo que se cobró.
  // - promoSavings: cuánto ahorró el comprador por promos (número suelto para métricas).
  // - promoSummary: JSON con QUÉ promos ganaron { applied:[{name,label,savings}], freeShipping }.
  promoSavings         Float   @default(0)
  promoSummary         String?
  trackingCode         String?
  notes                String?
  shippingAddress      String  @default("{}")
  lockedCommissionRate Float?

  // ── El consentimiento del art. 1116 inc. b, para ventas DIGITALES ─────────
  //
  // Un archivo que se descarga y queda para siempre está EXCEPTUADO del derecho
  // de arrepentimiento: lo dice el Código Civil y Comercial, art. 1116 inc. b.
  // Pero la excepción arranca con "excepto pacto en contrario", así que hay que
  // poder mostrar que la persona lo supo ANTES de pagar, no después de reclamar.
  //
  // Estas tres columnas son esa prueba: cuándo lo aceptó, desde dónde, y —lo que
  // más importa— QUÉ TEXTO decía la pantalla en ese momento. El texto se guarda
  // entero y no una versión ni un `true`: si mañana se cambia la redacción, una
  // venta vieja tiene que seguir mostrando la que su comprador leyó de verdad.
  // Un booleano no prueba nada; un texto con fecha, sí.
  //
  // Nulas en toda venta de TIENDA: allá el arrepentimiento corre completo y no
  // hay nada que exceptuar.
  digitalConsentAt    DateTime?
  digitalConsentIp    String?
  digitalConsentTexto String?

  // ── El recordatorio del carrito abandonado (Productos Digitales, plan Pro) ──
  //
  // Cuándo se le mandó el mail a quien empezó la compra y no la terminó. Nulo
  // mientras no se mandó ninguno, y se llena UNA sola vez: insistirle a alguien
  // que no quiso comprar es correo no deseado, y encima con nuestro dominio de
  // envío de por medio.
  //
  // Va en la orden y no en una tabla aparte porque acá el carrito abandonado ES
  // la orden sin pagar — ver `lib/carritos-digitales`. Nula en toda venta de
  // TIENDA, que tiene su propio `AbandonedCart`.
  recordatorioAt DateTime?

  /// De dónde vino la VISITA que terminó en esta compra digital: una de las
  /// etiquetas de `origen-visita` ("instagram", "whatsapp", "directo"…). La
  /// página de venta anota el referente y el utm al entrar, el checkout los
  /// manda al crear la orden y el servidor los clasifica. Es lo que permite
  /// decir "Instagram trajo 500 visitas y 12 ventas" y no sólo las visitas.
  /// Null en las órdenes de tiendas y en las digitales de antes de esto.
  origenVisita String?
  /// La campaña, con el mismo viaje que `origenVisita`: `utm_medium` pasado a
  /// la lista cerrada de `utm-digital` ("pago", "organico", "mail", "historia",
  /// "otro"), y `utm_campaign` / `utm_content` limpios y recortados. Es lo que
  /// permite decir "el anuncio 'video2' trajo 3 ventas". Null cuando la visita
  /// no traía etiquetas, en tiendas, y en lo digital de antes de esto.
  utmMedio    String?
  utmCampania String?
  utmAnuncio  String?
  /// El cupón digital con que se compró y cuánto descontó, en pesos. `total`
  /// ya viene descontado: esto es la explicación, no un número que se reste
  /// de nuevo. Null / 0 en las órdenes sin cupón y en las de tiendas.
  cuponCodigo String?
  descuento   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  items      OrderItem[]
  payment    Payment?
  shipping   Shipping?
  commission Commission?
  reviews    Review[]
  statusLogs OrderStatusLog[]

  /// Cada mail de entrega que salió por esta venta. Ver `DigitalEnvioLog`.
  enviosDigitales DigitalEnvioLog[]

  @@index([storeId, status, createdAt(sort: Desc)])
}

// Carrito con email/teléfono del comprador capturado durante el checkout
// pero que nunca se completó en una Order — usado para recordatorios de
// recuperación por email.
model AbandonedCart {
  id             String    @id @default(cuid())
  customerEmail  String
  customerName   String?
  customerPhone  String?
  items          String // JSON: [{productId, variantId, name, image, price, qty, size, color}]
  total          Float
  lastActivityAt DateTime  @default(now())
  reminderSentAt DateTime?
  recoveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, customerEmail])
  @@index([storeId])
}

// Respaldo generado automáticamente antes de un reset por cambio de rubro
// (ver /api/store/reset). El reset borra pedidos, pagos, comisiones y cupones
// del ciclo anterior porque son específicos del rubro viejo — pero esos
// registros representan plata real ya cobrada, así que antes de borrarlos
// se guarda acá una copia completa en JSON. Sirve de respaldo contable para
// el dueño y de prueba ante un reclamo/contracargo de Mercado Pago.
model StoreArchive {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  tipoTiendaAnterior String
  ordersCount        Int
  totalFacturado     Float
  data               String // JSON: { orders: [...con items/pago/envío/comisión/cupón], coupons: [...] }

  @@index([storeId])
}

model OrderStatusLog {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  changedBy  String
  changedAt  DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id         String @id @default(cuid())
  quantity   Int
  price      Float
  // Total real de la línea (precio efectivo × cantidad), calculado por el motor
  // de precios. En una promo N×M el descuento NO es uniforme por unidad, así que
  // price × quantity no reconstruye el total exacto — este campo lo guarda tal
  // cual se cobró. Nullable: las órdenes viejas caen en price × quantity.
  lineTotal  Float?
  // Costo del producto "congelado" al momento de la venta (copiado de
  // Product.costPrice en el checkout). No se recalcula si el costo del
  // producto cambia después — así un reporte de un mes cerrado no varía solo.
  costAtSale Float?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  descargas DigitalDownload[]
}

/// ── SIN USO HOY, y a propósito ─────────────────────────────────────────────
///
/// Esta tabla EXISTE EN LA BASE de producción: la migración
/// 20260829120000_add_digital_download se aplicó el 29/08/2026. Está vacía y
/// ningún código la toca desde que los productos digitales dejaron de ser un
/// rubro de tienda para pasar a ser un producto aparte, con su propio panel y su
/// propia suscripción.
///
/// **No se borra.** Borrar el modelo de acá no borra la tabla de la base: lo
/// único que lograría es que Prisma vea una tabla que su esquema no menciona, y
/// que la próxima migración de cualquier otra cosa pida un reset de la base de
/// producción. Y borrarla de verdad, con una migración, sería tirar un diseño
/// que costó una auditoría entera y que el ecosistema nuevo va a necesitar
/// igual — porque lo que cambia es el panel, no la entrega.
///
/// ── El diseño, para cuando se retome ───────────────────────────────────────
///
/// El permiso de descarga de un producto digital, emitido cuando el pago se
/// acredita. Es una fila por línea comprada, no por producto: dos personas que
/// compran el mismo PDF tienen cada una su token, su vencimiento y su cuenta.
///
/// El token NO es la ubicación del archivo: es una llave que se canjea en una
/// ruta que —después de mirar vencimiento y tope— le pide a Supabase un link
/// firmado de vida corta. Así el mail nunca lleva una dirección que sirva sola,
/// y el permiso se puede vencer o agotar sin tener que mover el archivo.
///
/// Lo aprendido armándolo (los 7 agujeros que tuvo, el techo real de 50 MB de
/// Supabase, por qué el bucket va anclado) está en PRODUCTOS-DIGITALES.md.
model DigitalDownload {
  id    String @id @default(cuid())
  /// Se canjea en la URL, así que va indexado y único. Se genera con
  /// `randomUUID`, nunca con `Math.random()`: el generador de JS es predecible a
  /// partir de unas pocas salidas del mismo proceso, y acá el token es lo ÚNICO
  /// que separa a un comprador del archivo de otro.
  token String @unique

  /// Cuándo deja de servir. 30 días desde la compra.
  expiresAt      DateTime
  /// Cuántas veces se usó y cuántas se permiten. El tope corta el reenvío del
  /// link a diez amigos sin castigar al que lo baja en el celular y en la compu.
  descargas      Int       @default(0)
  maxDescargas   Int       @default(5)
  /// Para que la dueña vea en el panel si el comprador lo bajó o nunca entró.
  ultimaDescarga DateTime?

  /// ÚNICO: un permiso por línea comprada, y la base es quien lo garantiza.
  /// Leer "¿ya existe?" antes de crear no alcanza — dos avisos de Mercado Pago
  /// en paralelo leen los dos "todavía no" y crean los dos, dejando dos tokens
  /// vivos y un tope de 10 descargas donde debía haber 5. Con la restricción
  /// acá, un `upsert` resuelve la carrera sin necesidad de transacción.
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// Una fila por descarga. Ver `DigitalDownloadLog`.
  registros DigitalDownloadLog[]

  createdAt DateTime @default(now())

  /// Para la limpieza de los vencidos, cuando vuelva a haber un cron que la haga.
  @@index([expiresAt])
}

/// ══════════════════════════════════════════════════════════════════════════
/// CADA VEZ QUE ALGUIEN BAJÓ UN ARCHIVO PAGO
/// ══════════════════════════════════════════════════════════════════════════
///
/// ── Para qué sirve de verdad ──────────────────────────────────────────────
///
/// Para un contracargo. Tener razón por el art. 1116 no frena a Mercado Pago:
/// ellos deciden mirando pruebas, y por defecto le creen a quien reclama. El
/// contador de `DigitalDownload` dice "se bajó 3 veces" y nada más — no dice
/// cuándo ni desde dónde, así que como prueba de entrega no alcanza.
///
/// Esta tabla sí: "el 05/09 a las 14:22, desde 190.x.x.x, con este navegador".
/// Eso es lo que se adjunta a una defensa.
///
/// ── Por qué una tabla y no dos columnas más ───────────────────────────────
///
/// Porque "la última descarga" no prueba nada útil: si alguien bajó el archivo
/// el día 1 y volvió a entrar el día 20, la única fecha guardada sería la del
/// 20 y la entrega original desaparece. Lo que se defiende es la PRIMERA.
///
/// ── Datos personales ──────────────────────────────────────────────────────
///
/// La IP identifica a una persona, así que esto se guarda por un motivo
/// concreto y acotado —probar la entrega ante un reclamo— y muere con el
/// permiso: `onDelete: Cascade`. Tiene que estar dicho en los términos.
model DigitalDownloadLog {
  id String @id @default(cuid())

  downloadId String
  download   DigitalDownload @relation(fields: [downloadId], references: [id], onDelete: Cascade)

  /// Puede faltar: detrás de ciertos proxys no llega ninguna cabecera confiable.
  /// Se guarda lo que haya y no se inventa un "0.0.0.0" que después alguien lee
  /// como si fuera una dirección de verdad.
  ip     String?
  /// Recortado antes de guardar: un `User-Agent` lo escribe el cliente y puede
  /// venir con kilobytes de basura.
  agente String?

  createdAt DateTime @default(now())

  @@index([downloadId, createdAt(sort: Desc)])
}

/// Cada mail de entrega que salió —o que NO salió— por una venta digital.
///
/// ══════════════════════════════════════════════════════════════════════════
/// EL AGUJERO QUE TAPA: NADIE PODÍA CONTESTAR "¿SALIÓ EL MAIL?"
/// ══════════════════════════════════════════════════════════════════════════
///
/// El mail de entrega se manda con `despues`, fuera de la respuesta al aviso de
/// Mercado Pago. Y si Resend se cae, `despues` se traga el error en un
/// `console.error` que nadie lee. Resultado: la venta figura **Cobrada**, quien
/// compró no recibió nada, y no queda un solo rastro en la base. Quien vende se
/// entera cuando le reclaman — o no se entera nunca y pierde al cliente.
///
/// Esta tabla es ese rastro. Anota los DOS caminos por los que sale el mail: el
/// automático del cobro y el botón de reenviar. Y anota los fallos igual que los
/// éxitos: un mail que no salió es justo el que hay que poder ver.
///
/// ── Por qué una tabla y no dos columnas en `Order` ─────────────────────────
///
/// Porque un contador y una "última fecha" pierden el medio. Es el mismo motivo
/// por el que `DigitalDownloadLog` guarda una fila por descarga en vez de sólo
/// la última: en un reclamo, "se lo mandamos el 3, el 5 y el 8" es una respuesta
/// y "3 veces, la última el 8" es media.
///
/// ── Y por qué se guarda a quién ────────────────────────────────────────────
///
/// Porque la dirección es parte de la prueba de entrega. "Se lo mandamos" no
/// dice nada; "se lo mandamos a juan@gmail.com el 3/9 a las 14:01" sí. Se guarda
/// la dirección tal como estaba ese día: si mañana la persona cambia su correo,
/// el envío viejo tiene que seguir diciendo a dónde fue de verdad.
model DigitalEnvioLog {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// ENTREGA (el automático, cuando se acredita el pago) o REENVIO (el botón).
  /// Texto y no enum: el resto del proyecto guarda los estados así, y un enum
  /// nuevo obliga a una migración cada vez que aparece un tercer motivo.
  motivo String

  /// ENVIADO o FALLO. Los fallos se guardan a propósito — son el único motivo
  /// serio por el que esta tabla existe.
  estado String

  /// A qué dirección salió, congelada al momento del envío.
  para String?

  /// Qué dijo el error, recortado. Sirve para distinguir "Resend está caído" de
  /// "esa dirección no existe", que se resuelven de maneras opuestas.
  error String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt(sort: Desc)])
}

/// Cuántas generaciones de IA le quedan a una cuenta digital.
///
/// ══════════════════════════════════════════════════════════════════════════
/// SON DOS BOLSAS, Y LA DIFERENCIA ES QUE UNA SE VENCE
/// ══════════════════════════════════════════════════════════════════════════
///
/// - **Bienvenida**: se dan una vez, al empezar, y **no vencen nunca**. Existen
///   porque el mes 1 es cuando se necesita todo —la persona está probando, no
///   sabe qué escribir y regenera varias veces— y el mes 6 no se necesita nada.
///   Ese primer día es el que decide si se queda.
/// - **Del mes**: se renuevan el 1° y **no se acumulan**. Si se acumularan,
///   alguien que no toca la cuenta durante un año llega al mes 13 con 120
///   generaciones juntas y el peor caso vuelve entero.
///
/// ⚠️ **Se gasta primero la del mes.** Le conviene a la persona: la del mes se
/// pierde si no la usa y la de bienvenida no. Al revés le quemaríamos su bolsa
/// permanente mientras se le vencen sin usar las del mes.
///
/// ── Por qué una tabla y no columnas en `Subscription` ──────────────────────
///
/// Porque el mismo molde lo va a usar el cupo de ebooks, que es el caro y el
/// que de verdad se vende. Con `concepto` adentro, los dos cupos son filas de
/// esta tabla en vez de cuatro columnas más en una tabla que ya es larga.
///
/// ── Por qué el mes se guarda como texto y no se reinicia con un cron ───────
///
/// `mesClave` guarda "2026-09". Cuando llega un pedido y la clave no es la del
/// mes actual, el contador se pone en cero **en ese momento**. Así el reinicio
/// no depende de que un proceso nocturno corra: si el cron no corre, no pasa
/// nada, porque nadie está esperando que corra.
/// Visitas a la página de venta de un producto digital, por día, y cuántas de
/// ellas llegaron al checkout. Una fila por (producto, día, paso, dispositivo).
///
/// Es `StoreView` + `StoreFunnelStep` colgadas del PRODUCTO y no de la tienda,
/// porque en este ecosistema cada producto principal es su propio sitio —su
/// dirección, su anuncio, su conversión— y una cuenta Pro tiene cinco. Un
/// número por cuenta no le dice cuál de los cinco anda.
///
/// `paso` es "pagina" (entró a la página de venta) o "pagar" (abrió el
/// checkout). La venta no se guarda acá: sale de `Order`, como siempre. Los
/// tres juntos son el embudo: entró → quiso pagar → pagó.
///
/// `dispositivo` es "movil" o "escritorio", y va en la clave y no en otra
/// tabla: sumar las dos filas da el total, y separarlas dice para qué pantalla
/// hay que armar la página. Lo decide el servidor con lo que el navegador
/// declara (puntero grueso), nunca con un texto libre.
///
/// Se cuenta como las visitas de tiendas: una vez por navegador por día, con
/// el dedup del lado del cliente y los filtros de `visita-legitima` del lado
/// del servidor. `date` es el día del calendario argentino.
model DigitalVisita {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  date        String // "2026-09-14", día argentino
  paso        String // "pagina" | "pagar"
  dispositivo String // "movil" | "escritorio"
  count       Int    @default(0)

  @@unique([productId, date, paso, dispositivo])
  @@index([productId, date(sort: Desc)])
}

/// De dónde vinieron las visitas a la página de venta, por día y por paso.
/// Una fila por (producto, día, paso, origen). Con `paso` "pagina" es de
/// dónde vino el que entró; con "pagar", de dónde había venido el que abrió
/// el checkout. Junto con las ventas de `Order.origenVisita` arman el embudo
/// POR CANAL: de los que vinieron de Instagram, cuántos quisieron pagar y
/// cuántos pagaron.
///
/// El origen del paso "pagar" no sale del referente de ese pedido —sería
/// siempre nuestra propia página— sino del que la página anotó al entrar y
/// el navegador manda con el ping (ver `anotarOrigen`). `paso` nació con
/// valor por defecto "pagina" porque la tabla existió primero sin él.
///
/// `source` sale de la lista cerrada de `src/lib/origen-visita.ts`, la misma
/// que usan las tiendas: un `utm_source` reconocido cae en su etiqueta, uno
/// desconocido en "otro", y sin utm decide el referente.
model DigitalVisitaOrigen {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  date      String
  paso      String  @default("pagina") // "pagina" | "pagar"
  source    String // una de ORIGENES
  count     Int    @default(0)

  @@unique([productId, date, paso, source])
  @@index([productId, date(sort: Desc)])
}

/// La campaña de cada visita a la página de venta, por día. Una fila por
/// (producto, día, medio, campaña, anuncio). Es el escalón de abajo de
/// `DigitalVisitaOrigen`: aquélla dice "vino de Instagram", ésta dice "del
/// anuncio 'video2' de la campaña 'lanzamiento', pago". Para el que paga
/// publicidad es LA tabla: es la que le dice qué anuncio apagar.
///
/// ⚠️ `campania` y `anuncio` son TEXTO DEL VISITANTE —lo que trae la URL— y
/// van en la clave, así que acá hay dos defensas que las otras tablas no
/// necesitan, las dos en `lib/utm-digital`: cada texto se limpia y se recorta
/// antes de entrar, y hay un techo de combinaciones distintas por producto y
/// por día; pasado el techo todo cae en una sola fila "(otras)". Sin eso, un
/// bot con nombres inventados llena la tabla en una tarde. `medio` sale de una
/// lista cerrada, como `source` en la de orígenes.
///
/// Sólo se escribe cuando la visita traía `utm_source`: una campaña sin fuente
/// no es una campaña, es alguien jugando con la URL.
model DigitalVisitaCampania {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  date      String // "2026-09-14", día argentino
  medio     String // una de MEDIOS
  campania  String // limpio, ≤ LARGO_UTM
  anuncio   String // limpio, ≤ LARGO_UTM; "" si no vino
  count     Int    @default(0)

  @@unique([productId, date, medio, campania, anuncio])
  @@index([productId, date(sort: Desc)])
}

/// Un cupón de descuento de Productos Digitales. Es de la CUENTA (una cuenta
/// Pro tiene hasta cinco páginas) y puede valer para todas o para un producto.
/// El código se guarda en mayúsculas y es único por cuenta. `usos` se suma al
/// CONFIRMARSE la compra, no al crearla: un carrito abandonado no gasta usos.
/// Lo que vale, cuánto y hasta cuándo lo decide `lib/cupones-digitales`.
/// Un mail de la vendedora a quienes le compraron. Pro. Ver
/// `lib/correos-compradores`: quién lo recibe se calcula al mandar (los
/// compradores confirmados del producto, o de la cuenta, menos las bajas),
/// no se guarda una lista. `cursor` es el último correo al que salió, para
/// retomar si el envío se corta: la lista va ordenada por correo.
model CorreoDigital {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// A los compradores de este principal; null = de toda la cuenta.
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  asunto        String
  cuerpo        String
  /// El botón del mail, ya armado con su etiqueta UTM. Null = sin botón.
  enlace        String?
  /// El texto del botón ("Ver <producto>"). Va con `enlace`.
  botonTexto    String?
  /// Cuántos había cuando se mandó.
  destinatarios Int
  enviados      Int      @default(0)
  fallidos      Int      @default(0)
  /// ENVIANDO | LISTO
  estado        String   @default("ENVIANDO")
  cursor        String?
  createdAt     DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([productId])
}

/// Quien pidió no recibir más mails de ESTA cuenta. Por (cuenta, correo) y
/// no por campaña: la baja es de la relación, no del mail que la provocó.
/// Una versión subida de la landing propia de un producto digital: el HTML
/// ya limpio (`limpiarLanding`), lo que trae adentro y lo que se le sacó. Se
/// guardan las últimas `LANDING_VERSIONES` por producto; la que se muestra la
/// dice `Product.landingPropia.versionId`. Ver `lib/landing-propia`.
model LandingDigital {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Limpio: sin scripts, con el CSS filtrado adelante. Hasta 500 KB.
  html       String
  bytes      Int
  titulo     String?
  /// JSON `InventarioDeLanding`: huecos, fotos, links vacíos, avisos.
  inventario String
  /// JSON `QuitadoDeLanding`: cuántos scripts, eventos, etc. se fueron.
  quitado    String
  createdAt  DateTime @default(now())

  @@index([productId, createdAt])
}

model BajaCorreoDigital {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Minúsculas, sin espacios: se compara contra el correo de la orden.
  email     String
  createdAt DateTime @default(now())

  @@unique([storeId, email])
}

model CuponDigital {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Mayúsculas, letras, números y guiones; 3 a 20.
  codigo    String
  /// "PORCENTAJE" (1–90) o "PESOS" (un monto fijo). Texto y no enum, como `concepto`.
  tipo      String
  valor     Int
  /// Null = vale para todos los principales de la cuenta.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  venceAt   DateTime?
  /// Null = sin tope.
  topeUsos  Int?
  usos      Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([storeId, codigo])
  @@index([productId])
}

model CupoIA {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// EMBUDO (armar las tres fichas) o EBOOK (escribir el PDF). Texto y no enum:
  /// un enum nuevo obliga a una migración cada vez que aparece un tercer uso.
  concepto String

  /// De la bolsa que no vence. Nunca se reinicia.
  bienvenidaUsadas Int @default(0)

  /// De la bolsa del mes, y de qué mes son ("2026-09").
  mesUsadas Int     @default(0)
  mesClave  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Una fila por cuenta y concepto. Lo garantiza la base: leer "¿ya existe?"
  /// antes de crear no alcanza — dos pedidos en paralelo leen los dos "todavía
  /// no" y crean dos filas, y ahí el cupo se duplica solo.
  @@unique([userId, concepto])
}

/// El ebook que la IA está escribiendo, o ya escribió, para un producto.
///
/// ── Por qué existe una tabla y no alcanza con generar y devolver ──────────
///
/// Porque no entra en un pedido. Una función de este plan de Vercel tiene 60
/// segundos y se corta; un ebook de verdad son diez capítulos y varios minutos.
/// Así que se escribe **de a un capítulo por pedido**, y entre pedido y pedido
/// lo escrito tiene que estar guardado en algún lado.
///
/// Y guardado en la base y no en la memoria del navegador: si alguien cierra la
/// pestaña en el capítulo 7, lo que ya se pagó no se puede perder. Al volver,
/// sigue donde estaba.
///
/// ── Uno por producto ──────────────────────────────────────────────────────
///
/// Rehacerlo pisa el mismo borrador. Por eso el contador de reintentos
/// sobrevive a la regeneración: si cada intento creara una fila nueva, el
/// "un reintento incluido" sería infinito.
model EbookIA {
  id String @id @default(cuid())

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Quién lo pidió. Es a quien se le devuelve el cupo si esto termina mal, y
  /// se guarda además del producto porque el producto se puede borrar y la
  /// devolución del cupo no puede depender de eso.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// En qué anda. Texto y no enum, igual que en `CupoIA`.
  ///
  ///   INDICE      — armando el temario.
  ///   ESCRIBIENDO — faltan capítulos.
  ///   COMPLETO    — están todos los capítulos, falta el PDF.
  ///   LISTO       — el PDF ya está colgado del producto.
  ///   FALLADO     — se cortó y quedó anotado el motivo en `error`.
  ///
  /// ⚠️ COMPLETO y LISTO no son lo mismo, y la diferencia importa: con COMPLETO
  /// el texto está escrito y pagado pero **el producto todavía no tiene nada
  /// que entregar**.
  estado String

  /// Lo que escribió la persona, tal como lo escribió. Se guarda para poder
  /// reintentar sin volver a pedírselo, y para saber de dónde salió cada texto.
  tema    String
  publico String?

  /// El título del ebook: el del producto, o el que propuso la IA.
  titulo String

  /// JSON, igual que `Product.paginaVenta`. La FORMA la declara `lib/ebook-ia`
  /// y lo que entra pasa antes por su limado; acá se guarda el resultado.
  ///
  /// `indice` son los capítulos planeados; `capitulos`, los ya escritos. Que
  /// sean dos campos es lo que deja saber cuánto falta sin adivinar.
  indice    String
  capitulos String

  /// De qué bolsa del cupo salió: "mes" o "bienvenida". Sin esto no se puede
  /// devolver lo gastado a la bolsa correcta.
  bolsa String?

  /// El reintento incluido: rehacer el ebook una vez no gasta cupo. A partir
  /// del segundo, sí. Si no, el costo no tiene fondo.
  reintentos Int @default(0)

  /// ⚠️ EL CANDADO. Cuándo empezó a escribirse el capítulo que está en curso.
  ///
  /// Dos pedidos a la vez escribirían dos veces el mismo capítulo —y lo
  /// cobrarían dos veces—. Se toma antes de llamar al modelo y se suelta al
  /// guardar. Vence solo: un pedido que murió a mitad de camino no puede dejar
  /// el ebook trabado para siempre.
  trabajandoDesde DateTime?

  /// Por qué falló, para poder decirlo en pantalla en vez de un "error".
  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// La pantalla de productos pide todos los ebooks de la cuenta de una.
  @@index([userId])
}

/// Una solicitud de arrepentimiento: alguien que compró y quiere dar marcha
/// atrás. La exige la Resolución 424/2020 — el botón tiene que estar a la vista
/// y sin registro, y tiene que devolver una constancia con número.
///
/// El derecho ya existía y estaba escrito en las políticas de cada tienda (los
/// 10 días del art. 34 de la Ley 24.240). Lo que faltaba era por dónde
/// ejercerlo: hasta acá, escribirle al comercio y esperar.
///
/// NO guarda una decisión, guarda un pedido. Qué se resuelve se resuelve entre
/// la persona y quien le vendió; la plataforma deja constancia de que la
/// solicitud entró, cuándo entró y con qué número. Eso es lo que sirve el día
/// que alguien reclama.
model Arrepentimiento {
  id String @id @default(cuid())

  /// El número que se le entrega como constancia. Se dicta por teléfono, así que
  /// no lleva las parejas que se confunden dichas en voz alta (O/0, I/1).
  /// Ver numeroDeConstancia() en lib/arrepentimiento.
  numero String @unique

  /// NULL a propósito: la solicitud puede ser contra una tienda **o contra
  /// TiendaApps**, que también vende (las suscripciones) y por lo tanto también
  /// necesita el botón. Sin esta columna nullable haría falta una segunda tabla
  /// idéntica para decir lo mismo.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  nombre     String
  email      String
  telefono   String?
  /// Con qué identifica su compra: número de pedido, o el email con el que la
  /// hizo. Es texto libre porque del otro lado hay alguien que quizá no encuentra
  /// el número, y pedirle un formato exacto sería trabarle el derecho.
  referencia String
  /// Opcional, y esto no es un descuido: el art. 34 dice "sin necesidad de
  /// justificar el motivo". Pedirlo obligatorio sería contradecir en el
  /// formulario lo que la política promete dos solapas más allá.
  motivo     String?

  /// RECIBIDO por ahora. El listado en el panel viene después; el dato se guarda
  /// desde el primer día para que ese listado no arranque sin historia.
  estado String @default("RECIBIDO")

  createdAt DateTime @default(now())

  @@index([storeId, createdAt(sort: Desc)])
}

model Payment {
  id         String   @id @default(cuid())
  provider   String   @default("mercadopago")
  externalId String?  @unique
  status     String   @default("PENDING")
  amount     Float
  currency   String   @default("ARS")
  createdAt  DateTime @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipping {
  id            String   @id @default(cuid())
  provider      String
  service       String?
  externalId    String?
  trackingCode  String?
  trackingUrl   String?
  labelUrl      String?
  status        String   @default("PENDING")
  estimatedDays Int?
  cost          Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Affiliate {
  id                 String    @id @default(cuid())
  status             String    @default("PENDING")
  isActive           Boolean   @default(false)
  // Marca que a esta afiliada la pausó el cierre de la tienda, no la dueña a
  // mano. Sin esto, `status = PAUSED` significaría dos cosas y al reactivar la
  // tienda le levantaríamos la suspensión a alguien que la dueña había pausado a
  // propósito. Solo las marcadas acá vuelven a APPROVED al reactivar.
  pausedByClosure    Boolean   @default(false)
  applicationMessage String?
  experience         String?
  cvUrl              String?
  socialUrl          String?
  requestedAt        DateTime  @default(now())
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  // Aceptación de términos y condiciones
  tcAcceptedAt       DateTime?
  tcVersion          String?
  tcAcceptedIp       String?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("AffiliateOwner", fields: [ownerId], references: [id])

  userId String
  user   User   @relation("AffiliateUser", fields: [userId], references: [id])

  orders      Order[]
  commissions Commission[]
  wallet      Wallet?
  clicks      AffiliateClick[]
  leads       Lead[]

  @@unique([storeId, userId])
  @@index([storeId, status])
}

model AffiliateClick {
  id               String    @id @default(cuid())
  affiliateId      String
  affiliate        Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  storeId          String
  productId        String?
  product          Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  ip               String?
  utmSource        String?
  convertedToOrder Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([affiliateId])
  @@index([storeId])
  @@index([createdAt])
  @@index([affiliateId, ip])
  @@index([productId])
}

model Commission {
  id             String    @id @default(cuid())
  amount         Float
  rate           Float
  status         String    @default("PENDING") // PENDING | PAID (wallet) | DISBURSED (MP directo)
  paidAt         DateTime?
  disbursedAt    DateTime?
  disbursementId String? // ID del pago en MP cuando status = DISBURSED
  createdAt      DateTime  @default(now())

  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  @@index([affiliateId, status])
}

model Wallet {
  id             String   @id @default(cuid())
  balance        Float    @default(0)
  totalEarned    Float    @default(0)
  totalWithdrawn Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  affiliateId String    @unique
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  withdrawals WalletWithdrawal[]
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model PublicReview {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  reviewer   String
  verified   Boolean  @default(false)
  verifiedBy String? // "auto" = cruzado con Order DB | "owner" = dueño lo marcó manualmente
  createdAt  DateTime @default(now())

  // "APPROVED" | "PENDING"
  //
  // Las de PRODUCTO nacen aprobadas: están atadas a algo concreto y le sirven a
  // quien está por comprar ese producto. Las de TIENDA nacen pendientes, porque
  // no apuntan a nada y van derecho a la portada — un formulario público de
  // "opiná sobre esta tienda" es lo más fácil de spamear que hay, ni siquiera
  // hace falta fingir que compraste.
  //
  // El default es APPROVED para que las que ya existen —todas de producto y ya
  // publicadas— queden como están sin tener que tocarlas.
  status String @default("APPROVED")

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Opcional: una reseña de TIENDA no habla de ningún producto. Antes era
  // obligatorio y por eso no se podían guardar.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, productId])
  // Para la cola de pendientes del panel y para el listado por tipo.
  @@index([storeId, status])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String
  label          String? // etiqueta visible (ej: "20% OFF") — usada por el widget
  discountType   String    @default("percentage")
  discountValue  Float
  minOrderAmount Float     @default(0)
  maxUses        Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  winnerEmail    String? // si no es null, solo este email puede usar el cupón (premios de gamificación)
  createdAt      DateTime  @default(now())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  orders             Order[]
  gamificationPrizes GamificationPrize[]

  @@unique([storeId, code])
}

// Promoción: descuento que se aplica solo en la tienda, sobre un alcance
// (toda la tienda / categoría / productos elegidos) y en un rango de fechas.
// A diferencia de los campos promo* del producto (que la Fase 2 reemplaza), es
// una entidad propia: una promo apunta a N productos, no al revés.
// Se llama StorePromotion (no Promotion) porque ya existe un model Promotion:
// el del panel admin del marketplace (banners de la home). Son cosas distintas.
model StorePromotion {
  id   String @id @default(cuid())
  name String // lo que ve la dueña en el panel (ej. "Verano en remeras")

  // Qué descuenta
  type           String // PERCENT | FIXED | N_PAY_M | FREE_SHIPPING
  value          Float? // % (1..90) o monto fijo; null en N_PAY_M y FREE_SHIPPING
  minQty         Int? // N de "llevá N"  (solo N_PAY_M)
  payQty         Int? // M de "pagá M"   (solo N_PAY_M, payQty < minQty)
  minOrderAmount Float  @default(0) // compra mínima para que aplique (0 = sin mínimo)

  // A qué se aplica. Arrays como JSON string, igual que tags/reelUrls del repo.
  scope      String @default("ALL") // ALL | CATEGORY | PRODUCTS
  categories String @default("[]") // JSON: nombres de categoría si scope=CATEGORY
  productIds String @default("[]") // JSON: ids de producto si scope=PRODUCTS

  // Cuándo corre. null = sin límite por ese lado. Al pasar endsAt deja de aplicar sola.
  startsAt DateTime?
  endsAt   DateTime?

  // Con qué se combina (por defecto NO, como Tiendanube). priority desempata.
  combinesWithCoupons    Boolean @default(false)
  combinesWithPromotions Boolean @default(false)
  priority               Int     @default(0)

  // Evento comercial al que pertenece ("Black Friday", "Día de la Madre", o uno
  // propio). null = promo suelta, sin evento. Cuando tiene valor, la tienda lo
  // muestra en el tag del producto y le pone su nombre al filtro del listado.
  // No cambia el cálculo del precio, es solo presentación.
  eventLabel String?

  isActive   Boolean   @default(true) // toggle pausar/activar
  archivedAt DateTime? // seteado = en historial, no aplica más

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, isActive, archivedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WalletWithdrawal {
  id              String    @id @default(cuid())
  amount          Float
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  notes           String?
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  // Snapshot de datos bancarios al momento de solicitar el retiro
  snapshotCbu     String?
  snapshotAlias   String?
  snapshotCuil    String?
  snapshotHolder  String?

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, status])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  location  String?
  text      String
  rating    Int      @default(5)
  photoUrl  String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// CUPONES DE PREMIO
// level:  SILVER | GOLD | DIAMOND
// type:   STORE | SUBSCRIPTION
// status: AVAILABLE | USED | EXPIRED
model AffiliateRewardCoupon {
  id            String    @id @default(cuid())
  code          String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // STORE
  level         String // SILVER | GOLD | DIAMOND
  discountValue Float
  earnedMonth   String // "2026-04"
  status        String    @default("AVAILABLE") // AVAILABLE | USED | EXPIRED
  usedAt        DateTime?
  usedOrderId   String?
  usedStoreName String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
}

// AUDIT DE CUENTAS ELIMINADAS — resguardo legal/fiscal
// Se crea al eliminar una cuenta desde el panel admin.
// Preserva aceptaciones de T&C y resumen de suscripción para disputas legales y AFIP.
model DeletedAccountAudit {
  id               String   @id @default(cuid())
  deletedAt        DateTime @default(now())
  deletedByAdminId String
  originalUserId   String
  originalEmail    String? // guardado antes de anonimizar
  originalName     String? // guardado antes de anonimizar
  accountType      String // OWNER | SELLER | BUYER
  accountCreatedAt DateTime

  // Aceptación de T&C generales al registrarse (cualquier rol)
  generalTermsAcceptedAt DateTime?
  generalTermsVersion    String?
  generalTermsAcceptedIp String?

  // Aceptación de T&C del programa de afiliados
  tcAffiliateAcceptedAt DateTime?
  tcAffiliateVersion    String?
  tcAffiliateAcceptedIp String?

  // Aceptación de T&C del programa de dueños de tienda
  tcOwnerAcceptedAt DateTime?
  tcOwnerVersion    String?
  tcOwnerAcceptedIp String?

  // Resumen de suscripción (para registro fiscal)
  subscriptionRole      String?
  subscriptionPlan      String?
  subscriptionStatus    String?
  subscriptionCreatedAt DateTime?
}

// LOG DE ACCIONES ADMIN — auditoría de seguridad interna
// Se registra cada acción relevante que un admin realiza desde el panel.
model AdminActionLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  adminId    String
  adminEmail String
  action     String // BAN | UNBAN | DELETE | CHANGE_STATUS | CHANGE_TIER | CHANGE_PLAN | TOGGLE_STORE
  targetId   String // userId o storeId afectado
  targetType String // USER | STORE | SUBSCRIPTION
  details    String // JSON con datos adicionales del cambio
  ip         String?
}

// PROMOCIONES — flyers que el admin de la plataforma sube y se muestran en
// un carrusel en la home pública. Máximo 3 activas a la vez (se valida en
// la API, no acá), ordenadas por sortOrder. sortOrder es único porque cada
// valor representa un "slot" fijo del panel admin (0, 1, 2) — esto es lo
// que evita que una doble carrera de clicks cree dos promociones en el
// mismo espacio.
model Promotion {
  id        String   @id @default(cuid())
  imageUrl  String
  link      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sortOrder])
}

// SUSCRIPCIONES
// status: TRIAL | ACTIVE | GRACE | EXPIRED | CANCELLED
// plan:   MONTHLY | ANNUAL
// role:   AFFILIATE | OWNER
model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               String // AFFILIATE | OWNER | DIGITAL — el registro de planes (planLimits.PLANES) es quien manda
  tier               String    @default("BASIC") // OWNER: BASIC | PREMIUM — DIGITAL: FREE | STARTER | PRO
  plan               String // MONTHLY | ANNUAL
  status             String    @default("TRIAL") // TRIAL | ACTIVE | GRACE | EXPIRED | CANCELLED
  trialEndsAt        DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  gracePeriodEndsAt  DateTime?
  // SIN USO: nadie lo lee ni lo escribe. Quedó de una función de "cancelar al fin
  // del período" que nunca se construyó (los términos la prometían: "podés
  // cancelar desde Mi Plan", y ese botón no existe). Hoy el equivalente real es
  // cerrar la tienda, que cancela la suscripción en el acto. Se deja la columna
  // porque borrarla es una migración destructiva y no molesta a nadie.
  cancelAtPeriodEnd  Boolean   @default(false)
  // Avisos ya enviados de este período. El cron corre una vez por día, pero si se
  // dispara dos veces (o a mano) no puede mandar el mismo mail de nuevo. Se
  // reinician solos al empezar un período nuevo — los devuelve periodFor().
  expiredNotifiedAt  DateTime?
  closingNotifiedAt  DateTime?
  // Sólo DIGITAL: desde cuándo está en Free POR HABER CAÍDO (la prueba que
  // terminó sin pagar, o el plan pago vencido). `null` en una cuenta que nació
  // Free y nunca tuvo otra cosa. Lo escribe `caidaAFree()` y lo lee el cron para
  // soltar los dominios propios de quien lleva mucho sin Pro: un dominio
  // conectado con Pro sigue anotado al caer —redirige, no se rompe— y se
  // suelta recién a los DIAS_DE_DOMINIO_EN_FREE. Ver `dominio-digital`.
  freeDesde          DateTime?
  mpPaymentId        String?
  // SIN USO: no hay suscripción recurrente de MercadoPago (preapproval). Los pagos
  // son de una vez por período y la renovación la hace la dueña a mano. Los
  // términos decían "las suscripciones se renuevan automáticamente" y era falso;
  // se corrigió el 15/07/2026.
  mpPreapprovalId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Consultas/leads para tiendas de tipo inquiry (VEHICULOS, INMOBILIARIA, etc.)
// Se crea cuando un cliente hace click en "Consultar por WhatsApp" desde un link de afiliado
model Lead {
  id               String     @id @default(cuid())
  storeId          String
  store            Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  affiliateId      String?
  affiliate        Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  productId        String?
  productName      String
  productPrice     Float
  customerName     String?
  customerPhone    String?
  customerMessage  String?
  // PENDING = consultó / CONFIRMED = venta confirmada / REJECTED = no concretó
  status           String     @default("PENDING")
  commissionAmount Float?
  commissionRate   Float?
  confirmedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([storeId, createdAt(sort: Desc)])
  @@index([affiliateId])
}

// Visitas diarias a la tienda — un registro por día por tienda.
// "date" es la fecha UTC en formato "YYYY-MM-DD".
// Se hace upsert (increment) desde el endpoint /api/store-views/[slug].
model StoreView {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  date    String // "2026-06-13" UTC
  count   Int    @default(0)

  @@unique([storeId, date])
  @@index([storeId, date(sort: Desc)])
}

/// De dónde vinieron las visitas de un día. Una fila por (tienda, día, origen).
///
/// Va aparte de `StoreView` y no como una columna suya a propósito. Meterle el
/// origen a `StoreView` obligaba a cambiarle la clave única, a rellenar todo el
/// historial con un "desconocido" inventado y a tocar los seis lugares que hoy
/// la leen. Así no se toca nada de lo que ya funciona.
///
/// El precio es que las dos cuentas pueden no dar iguales: `StoreView` tiene
/// todas las visitas y acá están sólo las de después de este cambio. Eso no es
/// un error a esconder — es el dato: la pantalla muestra la diferencia como
/// "de N visitas sabemos de dónde vinieron M", que es la verdad.
///
/// `source` sale siempre de la lista cerrada de `src/lib/origen-visita.ts`. Si
/// fuera el dominio crudo, una tienda linkeada desde cincuenta lados tendría
/// cincuenta filas por día para siempre.
model StoreViewSource {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  date    String // "2026-06-13", día del calendario argentino
  source  String // una de ORIGENES
  count   Int    @default(0)

  @@unique([storeId, date, source])
  @@index([storeId, date(sort: Desc)])
}

/// Los dos escalones del embudo que no se pueden sacar de ninguna otra tabla.
///
/// El recorrido completo es: entró → puso algo en el carrito → abrió el checkout
/// → escribió sus datos → hizo el pedido → pagó. El primero sale de `StoreView`,
/// los dos últimos de `Order` y el de los datos de `AbandonedCart`. Los dos del
/// medio no los sabía nadie, y son justo donde más gente se cae.
///
/// Se cuenta como las visitas: una vez por navegador por día por tienda, con el
/// dedup del lado del cliente. Así el denominador de arriba y el numerador de
/// abajo miden lo mismo y el porcentaje quiere decir algo.
///
/// `step` sale de la lista cerrada de `src/lib/embudo.ts`, por lo mismo que
/// `StoreViewSource.source`: es parte de la clave de la tabla.
model StoreFunnelStep {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  date    String // "2026-06-13", día del calendario argentino
  step    String // "carrito" | "checkout"
  count   Int    @default(0)

  @@unique([storeId, date, step])
  @@index([storeId, date(sort: Desc)])
}

model StoreReport {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reporterEmail String?
  reason        String
  description   String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeId])
  @@index([status, createdAt(sort: Desc)])
}

// Motivo por el que una dueña cerró su tienda. Se completa en el paso 2 del
// cierre y lo lee el admin en /admin/cierres para entender por qué se va la
// gente. Mismo patrón que StoreReport (motivo + comentario + estado leído).
//
// `storeName`/`ownerEmail`/`ownerName` son SNAPSHOTS a propósito, no se leen por
// la relación: si más adelante elimina la cuenta, `User.email` se anonimiza a
// deleted-*@deleted.invalid y `Store.name` pasa a "Tienda eliminada", así que el
// reporte mostraría "Tienda eliminada" en vez de quién cerró y por qué.
// DeletedAccountAudit ya usa esta misma estrategia por el mismo motivo.
model StoreClosure {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeName  String
  ownerEmail String
  ownerName  String?
  reason     String
  comment    String?
  status     String   @default("PENDING") // PENDING | REVIEWED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([storeId])
  @@index([status, createdAt(sort: Desc)])
}

// CANASTA SOLIDARIA / CAUSA LIBRE
// Campaña de donación colectiva. Una sola ACTIVE por tipo a la vez (ver
// índice parcial one_active_campaign_per_type, no expresable en este schema).
// type=CANASTA: goalAmount siempre se recalcula con calculateGoalAmount a
// partir de products + reservePct (nunca null en la práctica).
// type=LIBRE: no usa products; goalAmount es opcional (null = sin techo,
// el admin la cierra a mano); mediaUrl/mediaType/contactPhone presentan la
// causa al público (separado del testimonio de entrega post-cierre).
model DonationCampaign {
  id           String    @id @default(cuid())
  type         String    @default("CANASTA") // CANASTA | LIBRE
  name         String
  description  String?
  goalAmount   Float?
  reservePct   Float     @default(10)
  status       String    @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  bannerActive Boolean   @default(false)
  mediaUrl     String? // foto/video de presentación de la causa (solo LIBRE)
  mediaType    String? // IMAGE | VIDEO
  contactPhone String? // teléfono de contacto de la causa (solo LIBRE)
  deliveredAt  DateTime? // cuándo el admin confirmó a quién se le entregó — marca esta campaña como cerrada/archivada
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products      DonationProduct[]
  donations     Donation[]
  notifications DonationNotification[]
  testimonial   DonationTestimonial?

  @@index([type, status])
}

// Productos visuales de la canasta (no se compran individualmente,
// el fondo es general — sirven para mostrar el progreso visual por producto).
model DonationProduct {
  id          String           @id @default(cuid())
  campaignId  String
  campaign    DonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  image       String?
  targetPrice Float
  sortOrder   Int              @default(0)

  @@index([campaignId])
}

// Donación individual. userId es null para donantes invitados (igual que las
// compras en tienda permiten checkout sin cuenta). La dedup de "1 por persona"
// usa userId cuando hay sesión, o email+telefono cuando es invitado.
// OJO: la unicidad real está en índices únicos PARCIALES (WHERE status =
// 'CONFIRMED'), agregados a mano vía SQL — no se pueden expresar con @@unique
// en Prisma. Así, un intento de pago abandonado (PENDING) nunca bloquea un
// reintento real; solo bloquea cuando ya existe una donación confirmada.
model Donation {
  id             String           @id @default(cuid())
  campaignId     String
  campaign       DonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount         Float
  mpPaymentId    String?          @unique
  status         String           @default("PENDING") // PENDING | CONFIRMED | FAILED
  donorName      String
  donorPhone     String
  donorEmail     String
  donorLocalidad String
  createdAt      DateTime         @default(now())

  @@index([campaignId, status])
}

// Historial de avisos manuales mandados a los donantes (ej: novedades de la
// campaña). Se usa también para el límite de 3 envíos por día.
model DonationNotification {
  id         String           @id @default(cuid())
  campaignId String
  campaign   DonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  message    String
  sentCount  Int              @default(0)
  createdAt  DateTime         @default(now())

  @@index([campaignId, createdAt(sort: Desc)])
}

// Agradecimiento/reseña de una canasta ya entregada. El admin lo carga a
// mano (no hay subida pública) después de confirmar la entrega — por eso no
// necesita un estado de aprobación separado: que el admin lo suba ya implica
// que está aprobado.
model DonationTestimonial {
  id         String           @id @default(cuid())
  campaignId String           @unique
  campaign   DonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donorName  String
  mediaUrl   String?
  mediaType  String? // IMAGE | VIDEO
  text       String?
  createdAt  DateTime         @default(now())
}

// ─── GAMIFICACIÓN (Ruleta / Raspadita) ────────────────────────────────────────

model GamificationWidget {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  type     String  @default("SPIN") // SPIN | SCRATCH
  isActive Boolean @default(false)

  title       String  @default("¡Girá y ganá!")
  subtitle    String  @default("Probá tu suerte y ganá un premio")
  buttonText  String  @default("¡Girá y ganá!")
  reclaimText String  @default("Reclamar premio")
  legalText   String?
  centerType  String  @default("text") // text | logo
  centerText  String?

  triggerType   String  @default("FIRST_CLICK") // FIRST_CLICK | ON_ENTER | DELAY
  triggerDelay  Int?
  showFrequency String  @default("ONCE_SESSION") // ALWAYS | ONCE_SESSION | ONCE_EVER
  emailRequired Boolean @default(true)

  styles String @default("{}") // JSON de colores/estilos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prizes GamificationPrize[]
  spins  GamificationSpin[]
}

model GamificationPrize {
  id       String             @id @default(cuid())
  widgetId String
  widget   GamificationWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  label       String // "20% OFF", "Envío gratis", "Sin premio"
  probability Int // 0-100, deben sumar 100 por widget
  isNoPrize   Boolean @default(false)
  order       Int     @default(0) // orden en la ruleta/raspadita
  winHours    Int     @default(48) // horas de validez del cupón para el ganador, desde que gana

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([widgetId])
}

model GamificationSpin {
  id       String             @id @default(cuid())
  widgetId String
  widget   GamificationWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  email      String?
  ip         String
  prizeLabel String?
  isNoPrize  Boolean @default(false)
  couponId   String? // null si no hubo premio
  couponCode String? // código entregado (snapshot por si el cupón se borra)

  createdAt DateTime @default(now())

  @@unique([widgetId, email]) // previene doble giro por race condition; NULL != NULL → anónimos no se bloquean entre sí
  @@index([widgetId])
}

// ─── ACTIVITY FEED ────────────────────────────────────────────────────────────
// Eventos de actividad de la tienda. Se escribe server-side desde los
// endpoints de checkout, reviews y afiliados — nunca desde el cliente.
// "data" es un JSON truncado y sanitizado (sin emails, sin datos sensibles).
model StoreActivityEvent {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type      String // NEW_ORDER | NEW_REVIEW | NEW_AFFILIATE | CART_RECOVERED
  data      String   @default("{}") // JSON: { total?, buyerName?, productName?, reviewerName?, rating?, affiliateName? }
  createdAt DateTime @default(now())

  @@index([storeId, createdAt(sort: Desc)])
}

// ─── MILESTONES (hitos de celebración) ───────────────────────────────────────
// Registra hitos logrados por la tienda. @@unique garantiza que cada hito
// se registra una sola vez por tienda a nivel de DB (upsert safe contra races).
// shownAt null = aún no mostrado al dueño → el CelebrationManager lo pide.
model StoreMilestone {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type       String // FIRST_ORDER | FIRST_REVIEW | FIRST_AFFILIATE | REVENUE_1K | REVENUE_10K | REVENUE_50K
  achievedAt DateTime  @default(now())
  shownAt    DateTime?

  @@unique([storeId, type])
  @@index([storeId, shownAt])
}

// ─── DESIGN BRIEF (formulario "Diseñá tu propia tienda") ──────────────────────
// Una idea de diseño mandada desde /diseno-propio. No tiene relación con Store
// ni con User a propósito: el formulario es público y sin registro, así que la
// mayoría de los briefs llegan de gente que todavía no tiene cuenta. Si ya tiene
// tienda lo dice en tiendaUrl, como texto libre, para no atarlo a un FK que en
// la mayoría de los casos estaría vacío.
//
// La idea no es construir una plantilla por brief — cada plantilla es un
// componente de ~1200 líneas y un impuesto de mantenimiento permanente. Se
// construye por patrón: se agrupan por tipoTienda + estetica y se hace primero
// lo que más se repite, para que cada diseño nuevo le sirva a muchas y no a una.
model DesignBrief {
  id              String   @id @default(cuid())
  // Qué pidió
  tipoTienda      String // ROPA | HOGAR_TECH | AUTOS | GASTRONOMIA | HOTELERIA | INMOBILIARIA | GENERAL (ver lib/designBrief RUBROS)
  estetica        String // ver lib/designBrief ESTETICAS
  paleta          String // ver lib/designBrief PALETAS
  coloresPropios  String?
  referencias     String?
  noQuiero        String?
  // Datos que definen la anatomía de la plantilla (ver lib/designBrief).
  // Opcionales porque los briefs anteriores a esta pregunta no los tienen.
  nombreTienda    String?
  queVende        String? // "remeras de mujer", "repuestos de moto": el rubro solo no alcanza
  fotos           String? // propias | algunas | catalogo | ninguna
  catalogo        String? // chico | medio | grande | enorme
  logo            String? // tengo | feo | no
  // Quién lo pidió
  nombre          String
  email           String
  telefono        String?
  tieneTienda     Boolean  @default(false)
  tiendaUrl       String?
  // Aceptación de que el diseño se publica en el catálogo. Mismo patrón que
  // tcOwner* de Store (fecha + IP + versión), pero con su propia versión:
  // DESIGN_BRIEF_TERMS_VERSION en lib/legal, no CURRENT_TERMS_VERSION.
  acceptedAt      DateTime @default(now())
  acceptedIp      String?
  acceptedVersion String
  // NEW = sin mirar | REVIEWED = leído | BUILDING = se está diseñando
  // DONE = la plantilla ya está publicada | DISCARDED = no se va a hacer
  status          String   @default("NEW")
  createdAt       DateTime @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@index([tipoTienda, estetica])
}

// ─── ADMIN SECTION VIEW (puntito de "algo nuevo" del panel admin) ─────────────
// Registra cuándo el admin abrió por última vez cada sección del panel que
// recibe cosas (diseños, leads/consultas, testimonios, donaciones). El badge del
// sidebar cuenta lo que entró DESPUÉS de seenAt — el mismo criterio que
// abandonedCartsSeenAt de Store, pero acá global por admin y por sección, para no
// sumar una columna nueva cada vez que aparece una sección más.
//
// Sin relación formal a User (solo userId) a propósito: son pocos admins, y así
// no hay que tocar el modelo User ni cascada al borrar. section es texto libre
// controlado desde el código (ADMIN_SECTIONS en lib), no un enum de DB.
model AdminSectionView {
  id      String   @id @default(cuid())
  userId  String
  section String // disenos | leads | testimonios | donaciones
  seenAt  DateTime @default(now())

  @@unique([userId, section])
}
